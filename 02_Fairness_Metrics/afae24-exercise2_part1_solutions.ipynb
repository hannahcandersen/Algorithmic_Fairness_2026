    "    if temp.shape[0] == 0:\n",
    "        P_eqg1=0\n",
    "    else:\n",
    "        P_eqg1 = temp.S.sum()/temp.shape[0]\n",
    "\n",
    "    #P(S=1|G=0,T=1)\n",
